# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# PostgreSQL connection for the API. The double underscore maps to ConnectionStrings:Default.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=smoothbudget;Username=smoothbudget;Password=CHANGE_ME

# Password for the fake demo login created by the seed script (demo@smoothbudget.test).
# Use at least 10 characters with an upper-case letter, a lower-case letter and a digit.
SEED_DEMO_PASSWORD=CHANGE_ME_Demo1234

# Local Postgres superuser password (only used to create the database by hand).
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# Plaid credentials (milestone 3). Start with sandbox; production needs Plaid's approval.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32 random bytes, base64. Encrypts Plaid access tokens in the database. Generate one with:
#   pwsh -c "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
# Losing it means re-linking your banks; changing it makes stored tokens unreadable.
PLAID_TOKEN_KEY=
# Optional: public HTTPS URL of /api/plaid/webhook (only when hosted; Plaid can't reach localhost).
PLAID_WEBHOOK_URL=
# Optional: where a bank's own sign-in (Chase) sends you back, e.g. https://YOUR-APP.onrender.com/plaid-oauth.
# Add it to Allowed redirect URIs in the Plaid dashboard first (DEPLOY.md step 5). Not needed locally.
PLAID_REDIRECT_URI=

# Optional: phone notifications (Web Push). Without these the feature is off. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is the app's own address (an https URL), never a personal email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://smoothbudget.onrender.com
# Home's "Update bank data" (DECISIONS.md 242): Plaid charges for each check. Per bank connection: one every N hours, and at
# most N a month (UTC calendar month). Set the price in cents to show the month's cost next to the count.
PLAID_BANK_CHECK_HOURS=4
PLAID_BANK_CHECKS_PER_MONTH=30
PLAID_BANK_CHECK_PRICE_CENTS=
